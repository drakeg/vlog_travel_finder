# Local Docker Compose settings
APP_PORT=5000
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=sqlite:////app/instance/vlog_site.sqlite
CSRF_ENABLED=true
SESSION_COOKIE_SECURE=false
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000
FLASK_DEBUG=1

# For an HTTPS production deployment:
# APP_ENV=production
# SECRET_KEY=<generate-a-long-random-secret>
# SESSION_COOKIE_SECURE=true
# SECURITY_HSTS_ENABLED=true
# SECURITY_HSTS_MAX_AGE=31536000
# FLASK_DEBUG=0

# Optional external nearby destination search (disabled by default).
# Configure an operator-managed Overpass endpoint and its deployment-wide
# usage budget before enabling. Coordinates are only sent after a user clicks.
FILMING_LIVE_DISCOVERY_ENABLED=false
FILMING_OVERPASS_URL=
FILMING_OSM_USER_AGENT=VlogTravelFinder-FilmingPlanner/1.0 (+https://github.com/drakeg/vlog_travel_finder)
